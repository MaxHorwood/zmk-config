#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define QWERTY     0
#define GAME       1
#define MOVE       2
#define SYMBOL     3
#define GAME_ARROW 4
#define NUM        5
#define FUN        6
#define MEDIA      7

/ {
    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &none  &none     &none     &none    &none                                     &none       &none    &none      &none      &none     &none
&kp TAB    &kp Q  &kp W     &kp E     &kp R    &kp T                                     &kp Y       &kp U    &kp I      &kp O      &kp P     &kp DEL
&kp LSHFT  &kp A  &kp S     &kp D     &kp F    &kp G                                     &kp H       &kp J    &kp K      &kp L      &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X     &kp C     &kp V    &kp B     &kp C_MUTE    &none  &kp N       &kp M    &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                  &kp LGUI  &kp LALT  &mo FUN  &mo MOVE  &kp SPACE     &kp RET           &mo SYMBOL  &mo NUM  &mo MEDIA  &tog GAME
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4  &kp N5                                  &kp N6      &kp N7   &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W     &kp E   &kp R   &kp T                                   &kp Y       &kp U    &kp I      &kp O      &kp P     &tog GAME_ARROW
&kp LSHFT  &kp A   &kp S     &kp D   &kp F   &kp G                                   &kp H       &kp J    &kp K      &kp L      &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C   &kp V   &kp B   &kp C_MUTE    &none  &kp N       &kp M    &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                   &kp LGUI  &trans  &trans  &trans  &kp SPACE     &kp RET           &mo SYMBOL  &mo NUM  &mo MEDIA  &tog GAME
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        move_layer {
            display-name = "Move";
            bindings = <
&trans  &none     &none   &none   &none   &none                     &none      &none     &none     &none      &none     &none
&trans  &kp BSPC  &kp N7  &kp N8  &kp N9  &none                     &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp DEL   &none
&trans  &kp N0    &kp N4  &kp N5  &kp N6  &none                     &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp BSPC  &none
&trans  &trans    &kp N1  &kp N2  &kp N3  &none   &trans    &trans  &none      &none     &none     &kp DOT    &none     &none
                  &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        symbol_layer {
            display-name = "Symb";
            bindings = <
&kp GRAVE  &none            &none      &none      &kp PIPE         &kp POUND                          &tog GAME  &none     &none     &none      &none   &kp BSPC
&trans     &kp CARET        &kp EXCL   &kp ASTRK  &kp PIPE         &kp DLLR                           &none      &kp AT    &kp SQT   &kp GRAVE  &none   &kp DEL
&trans     &kp PLUS         &kp MINUS  &kp EQUAL  &kp UNDER        &kp NON_US_HASH                    &none      &kp LBRC  &kp LPAR  &kp LBKT   &trans  &trans
&trans     &kp NON_US_BSLH  &kp PRCNT  &kp AMPS   &kp NON_US_BSLH  &kp QMARK        &trans    &trans  &none      &kp RBRC  &kp RPAR  &kp RBKT   &trans  &trans
                            &trans     &trans     &trans           &trans           &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        game_arrow_layer {
            display-name = "Garo";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans     &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &to GAME
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans                    &trans  &trans  &trans  &trans   &trans  &trans
&trans  &kp BSPC   &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans                    &trans  &trans  &trans  &trans   &trans  &trans
&trans  &kp KP_N0  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans                    &trans  &trans  &trans  &trans   &trans  &trans
&trans  &trans     &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans    &trans  &trans  &trans  &trans  &kp DOT  &trans  &trans
                   &trans     &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
&trans  &none  &kp F10  &kp F11  &kp F12  &kp PSCRN                    &none   &none   &none   &none    &none     &none
&trans  &none  &kp F7   &kp F8   &kp F9   &kp SLCK                     &none   &none   &none   &none    &kp DEL   &none
&trans  &none  &kp F4   &kp F5   &kp F6   &kp CLCK                     &none   &none   &none   &none    &kp BSPC  &none
&trans  &none  &kp F1   &kp F2   &kp F3   &kp LNLCK  &none     &none   &none   &none   &none   &kp DOT  &none     &none
               &trans   &trans   &trans   &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_DN PG_UP>;
        };

        media_layer {
            display-name = "Medi";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &kp C_CALC  &none       &none         &none       &none  &none
&trans  &trans  &trans  &trans  &trans  &trans                  &none       &kp C_STOP  &kp C_VOL_UP  &kp C_PP    &none  &none
&trans  &trans  &trans  &trans  &trans  &trans                  &none       &kp C_PREV  &kp C_VOL_DN  &kp C_NEXT  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans  &none    &none  &none       &none       &none         &kp C_MUTE  &none  &none
              &none  &none  &none  &none  &none    &none  &none       &none       &trans        &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };
    };
};